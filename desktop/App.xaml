<Application x:Class="WasteVision.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand Accent Colors & Tokens -->
            <Color x:Key="WasteMint">#0C9B79</Color>
            <Color x:Key="WasteMintGlow">#5FD8C4</Color>
            <Color x:Key="WasteBlue">#1688C7</Color>
            <Color x:Key="WasteCyan">#38BDF8</Color>
            <Color x:Key="WasteAmber">#F2AE4B</Color>
            <Color x:Key="WasteEmerald">#10B981</Color>
            <Color x:Key="WasteRose">#F43F5E</Color>

            <SolidColorBrush x:Key="WasteAccent" Color="{StaticResource WasteMint}" />
            <SolidColorBrush x:Key="WasteMintBrush" Color="{StaticResource WasteMint}" />
            <SolidColorBrush x:Key="WasteMintGlowBrush" Color="{StaticResource WasteMintGlow}" />
            <SolidColorBrush x:Key="WasteBlueBrush" Color="{StaticResource WasteBlue}" />
            <SolidColorBrush x:Key="WasteCyanBrush" Color="{StaticResource WasteCyan}" />
            <SolidColorBrush x:Key="WasteAmberBrush" Color="{StaticResource WasteAmber}" />
            <SolidColorBrush x:Key="WasteEmeraldBrush" Color="{StaticResource WasteEmerald}" />
            <SolidColorBrush x:Key="WasteRoseBrush" Color="{StaticResource WasteRose}" />

            <!-- Gradients for Hero Cards & Badges -->
            <LinearGradientBrush x:Key="WasteGradientMintCyan" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C9B79" Offset="0.0"/>
                <GradientStop Color="#1688C7" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WasteHeroGlowGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#220C9B79" Offset="0.0"/>
                <GradientStop Color="#151688C7" Offset="0.5"/>
                <GradientStop Color="#00000000" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Theme-Specific Specular Glass Dictionaries -->
            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK THEME (Obsidian & Ambient Glow) -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1317"/>
                    <SolidColorBrush x:Key="CardGlassBrush" Color="#162228"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3D45"/>
                    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#5FD8C4"/>
                    <SolidColorBrush x:Key="HeaderGlassBrush" Color="#121B20"/>
                    <SolidColorBrush x:Key="NavGlassBrush" Color="#0E161A"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="TileSoftBackgroundBrush" Color="#1B2930"/>
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#23353D"/>
                </ResourceDictionary>

                <!-- LIGHT THEME (Soft Neumorphic & Crisp White) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7FB"/>
                    <SolidColorBrush x:Key="CardGlassBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#0C9B79"/>
                    <SolidColorBrush x:Key="HeaderGlassBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NavGlassBrush" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
                    <SolidColorBrush x:Key="TileSoftBackgroundBrush" Color="#F0FDFC"/>
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E2E8F0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
